<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<style>
	@media (prefers-color-scheme: dark){
		body {color:#fff;background:#000}
		a:link {color:#9cf}
		a:hover, a:visited:hover {color:#cef}
		a:visited {color:#c9f}
	}
	body{ margin:1em auto; max-width:40em; padding:0 .62em; font:1.2em/1.62 sans-serif; }
	h1,h2,h3 { line-height:1.2; }
	td {padding: 0 0.5em}
</style>
</head>
<body>

<h1>Widdler-ex</h1>
<h2>Backups</h2>

<table><thead><tr><th>File</th><th>Date</th><th>Action</th></tr></th><tbody>
	{{ $prefix := .Prefix }}
	{{ range .Backups }}
	<tr>
		<td><a href="{{ $prefix }}/{{ .ID }}/view">{{ .Filename }}</a></td>
		<td>{{.Timestamp | formatDate }}</td>
		<td><a href="{{ $prefix }}/{{ .ID }}/restore">Restore</a></td>
	{{end}}
</tbody></table>

</body>
</html>
