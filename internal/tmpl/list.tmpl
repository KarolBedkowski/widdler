<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<style>
	@media (prefers-color-scheme: dark){
		body {color:#fff;background:#000}
		a:link {color:#9cf}
		a:hover, a:visited:hover {color:#cef}
		a:visited {color:#c9f}
	}
	body{ margin:1em auto; max-width:40em; padding:0 .62em; font:1.2em/1.62 sans-serif; }
	h1,h2,h3 { line-height:1.2; }
	td{padding: 0 0.5em}
</style>

</head>
<body>

<h1>Widdler-ex <small>{{ .Path }}</small></h1>
{{ if .SupportBackupsDir }} <a href="/_backups">Backups</a>{{ end }}
<hr/>

{{ $base := .Path }}


<table>
	<tbody>
{{ with .Parent }}
	<tr><td><a href="{{ . }}">◀️ Go up...</a><br/></td></tr>
{{ end }}

{{ range .Dirs }} 
	<tr>
		<td><a href="{{ $base }}/{{ .Name }}">📁 {{ .Name }}</a></td>
		<td>{{ .Info.ModTime | formatDate }}</td>
	</tr>
{{ end }}

{{ range .Files }} 
	<tr>
		<td><a href="{{ $base }}/{{ .Name }}">📄 {{ .Name }}</a></td>
		<td>{{ .Info.ModTime | formatDate }}</td>
		<td>{{ .Info.Size | formatSize }}</td>
	</tr>
{{ end }}
	</tbody>
</table>

</br>

</body>
</html>
