
{% code
type ServerBrowserIndexPage struct {
	data *DirContent
}
%}

{% func (p *ServerBrowserIndexPage) Title() %}
{% endfunc %}

{% func (p *ServerBrowserIndexPage) Body() %}

<h2>Files</h2>

{% if len(p.data.Dirs) == 0 && len(p.data.Files) == 0 %}
<p><en>No files found; pleace create new.</em></p>
{% else %}

{%= p.renderTable() %}
{% endif %}


<hr/>

<h3>Create new, empty wiki</h3>
<form method="POST">
	<label>File name: </label>
	<input type="text" name="filename" />
	<button type="submit">Create</button>
</form>

<hr/>

{% if p.data.SupportBackupsDir %}

<h3>Backups</h3>
<a href="/_backups">Browse backuped files</a>

{% endif %}


{% endfunc %}

{% func (p *ServerBrowserIndexPage) renderTable() %}

<table>
	<thead>
		<tr><th>Name</th><th>Date</th><th>Size</th></tr>
	</thead>
	<tbody>
{% if p.data.Path != "" %}
	<tr><td><a href="{%s p.data.Parent %}">◀️ Go up...</a><br/></td></tr>
{% endif %}

{% for _, d := range p.data.Dirs %}
	<tr>
		<td><a href="{%s p.data.Path %}/{%s d.Name() %}">📁 {%s d.Name() %}</a></td>
		<td>{%s formatDate(must(d.Info()).ModTime()) %}</td>
	</tr>
{% endfor %}

{% for _, f := range p.data.Files %}
	<tr>
		<td><a href="{%s p.data.Path %}/{%s f.Name() %}">📄 {%s f.Name() %}</a></td>
		{% code info := must(f.Info()) %}
		<td>{%s formatDate(info.ModTime()) %}</td>
		<td>{%s formatSize(info.Size()) %}</td>
	</tr>
{% endfor %}
	</tbody>
</table>

{% endfunc %}

# vim:ft=mako:
