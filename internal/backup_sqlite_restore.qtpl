{% code
type SqlteBackupsRestorePage struct {
	filename string
}
%}

{% func (p *SqlteBackupsRestorePage) Title() %} - Backup restore{% endfunc %}

{% func (p *SqlteBackupsRestorePage) Body() %}
<h2>Backup</h2>
<h3>Restore file {%s p.filename %}</h3>

<form method="POST">
	<label>Target filename: </label>
	<input type="text" name="filename" value="{%s p.filename %}" />
	<button type="submit">Restore</button>
</form>

</body>
</html>

{% endfunc %}

# vim:ft=mako:
