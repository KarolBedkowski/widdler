{% func SqlteBackupsRestore(filename string) %}

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<style>
{% cat "main.css" %}
</style>
</head>
<body>

<h1>Widdler-ex</h1>
<h2>Backup</h2>
<h3>Restore file {%s filename %}</h3>

<form method="POST">
	<label>Target filename: </label>
	<input type="text" name="filename" value="{%s filename %}" />
	<button type="submit">Restore</button>
</form>

</body>
</html>

{% endfunc %}

